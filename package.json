{
  "name": "@thekrystalship/krystal-ui",
  "version": "0.1.0",
  "description": "The Krystal design system as React components, stores and stylesheets, shared by every TheKrystalShip web surface.",
  "license": "GPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheKrystalShip/krystal-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "styles",
    "styles.css",
    "fonts",
    "assets"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./lib/*": "./dist/lib/*.js",
    "./styles.css": "./styles.css",
    "./styles/*": "./styles/*",
    "./fonts/*": "./fonts/*",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./dist/lib/theme.js",
    "./dist/lib/toasts.js"
  ],
  "scripts": {
    "build": "vite build",
    "prepack": "vite build"
  },
  "peerDependencies": {
    "lucide-react": ">=0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  }
}
