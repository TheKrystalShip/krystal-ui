{
  "name": "@thekrystalship/krystal-ui",
  "version": "0.31.0",
  "description": "The Krystal design system as React components, stores and stylesheets, shared by every TheKrystalShip web surface.",
  "license": "GPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheKrystalShip/krystal-ui.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "styles",
    "styles.css",
    "fonts",
    "assets"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./styles.css": "./styles.css",
    "./styles/*": "./styles/*",
    "./fonts/*": "./fonts/*",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./dist/lib/theme.js",
    "./dist/lib/toasts.js"
  ],
  "scripts": {
    "build": "vite build && tsc",
    "prepack": "npm run build",
    "play": "vite playground",
    "lint": "eslint src scripts",
    "check:types": "tsc --noEmit",
    "check:markdown": "node scripts/check-markdown-highlight.mjs",
    "check:themes": "node scripts/check-themes.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "peerDependencies": {
    "lucide-react": ">=0.460.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.5"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9"
  }
}
