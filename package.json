{
  "name": "tks-krystal",
  "private": true,
  "description": "The Krystal design system: the @thekrystalship/krystal and @thekrystalship/krystal-chat packages.",
  "license": "GPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheKrystalShip/tks-krystal.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @thekrystalship/krystal && npm run build -w @thekrystalship/krystal-chat",
    "play": "vite playground",
    "lint": "eslint packages scripts playground",
    "check:types": "npm run build -w @thekrystalship/krystal && npm run check:types --workspaces",
    "check:markdown": "node scripts/check-markdown-highlight.mjs",
    "check:themes": "node scripts/check-themes.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.5"
  }
}
