{
  "name": "tks-krystal",
  "private": true,
  "description": "The Krystal design system: the @thekrystalship/krystal and @thekrystalship/krystal-chat packages.",
  "license": "GPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheKrystalShip/tks-krystal.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @thekrystalship/krystal && npm run build -w @thekrystalship/krystal-chat",
    "docs:data": "node scripts/docs-props.mjs && node scripts/docs-tokens.mjs",
    "play": "npm run docs:data && vite playground",
    "build:docs": "npm run docs:data && vite build playground",
    "lint": "eslint packages scripts playground test",
    "check:types": "npm run build -w @thekrystalship/krystal && npm run check:types --workspaces",
    "check:markdown": "node scripts/check-markdown-highlight.mjs",
    "check:themes": "node scripts/check-themes.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:contract": "node scripts/check-contract.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:palettes": "node packages/krystal/bin/krystal-check-theme.mjs packages/krystal/styles/tokens.css",
    "test": "vitest run",
    "test:a11y": "playwright test --config test/playwright.config.js test/a11y",
    "test:visual": "node scripts/test-visual.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stylelint": "^16.26.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
