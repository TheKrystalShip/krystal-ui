{
  "name": "@thekrystalship/krystal",
  "version": "3.0.3",
  "description": "The Krystal design system as React components, stores and stylesheets, shared by every TheKrystalShip web surface.",
  "license": "GPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheKrystalShip/tks-krystal.git",
    "directory": "packages/krystal"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist",
    "styles",
    "styles.css",
    "fonts",
    "assets",
    "bin",
    "lint",
    "tools",
    "theme-contract.json"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "krystal-check-theme": "./bin/krystal-check-theme.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./eslint": "./lint/eslint.js",
    "./stylelint": "./lint/stylelint.js",
    "./theme-contract.json": "./theme-contract.json",
    "./styles.css": "./styles.css",
    "./styles/*": "./styles/*",
    "./fonts/*": "./fonts/*",
    "./assets/*": "./assets/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./dist/lib/theme.js",
    "./dist/lib/toasts.js"
  ],
  "scripts": {
    "build": "vite build && tsc",
    "prepack": "npm run build",
    "check:types": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "lucide-react": ">=0.460.0",
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0",
    "stylelint": "^16.0.0"
  },
  "dependencies": {
    "@floating-ui/react-dom": "^2.1.9",
    "react-hook-form": "^7.90.0"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    },
    "stylelint": {
      "optional": true
    }
  }
}
